# Copy to an ignored local environment file and fill with local/test-only values. Never version secrets.
# NODE_ENV controls runtime security and test-only routes. APP_ENV identifies the deployment.
# Railway production uses NODE_ENV=production and APP_ENV=production.
# WOMPI_ENVIRONMENT independently chooses Wompi Sandbox (current) or production (future, blocked).
# PORT is optional (defaults to 3000); HOST is optional (defaults to 127.0.0.1).
# Production migrations additionally require MIGRATION_DB_USER and MIGRATION_DB_PASSWORD.
NODE_ENV=test
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reserva_canchas_test
DB_PASSWORD=replace_with_test_password
DB_NAME=reserva_canchas_test
# In development/test, password-reset and booking messages share this private JSONL outbox.
# PASSWORD_RESET_OUTBOX_PATH=absolute/path/to/private/outbox.jsonl
# Production requires a verified sender and Resend API credential. EMAIL_FROM is optional
# when the deployed PASSWORD_RESET_FROM_EMAIL is already configured (backward compatible).
# EMAIL_FROM=Reserva Canchas <soporte@canchapp.online>
# PASSWORD_RESET_FROM_EMAIL=Reserva Canchas <recuperacion@example.com>
# RESEND_API_KEY=replace_in_production_environment_only
# Optional Google Identity Services Web Client ID (same ID as VITE_GOOGLE_CLIENT_ID).
# Without it, password authentication remains available and Google returns 503.
# GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
# AUTH_TEST_GOOGLE_SECRET is only recognized when NODE_ENV=test.
# Railway production currently processes only Wompi Sandbox payments and refunds.
# All five Wompi values are required together; partial or mixed-environment keys block startup.
# WOMPI_ENVIRONMENT=production remains disabled until the production Wompi phase.
# These placeholders are not credentials. Keep real values only in an ignored local file or secret manager.
# WOMPI_ENVIRONMENT=sandbox
# WOMPI_PUBLIC_KEY=pub_test_replace_me
# WOMPI_PRIVATE_KEY=prv_test_replace_me
# WOMPI_INTEGRITY_SECRET=test_integrity_replace_me
# WOMPI_EVENTS_SECRET=test_events_replace_me
# Required to create Refunds V2; obtain merchant ID for this Sandbox account.
# WOMPI_MERCHANT_ID=replace_with_sandbox_merchant_id
# Optional backend-only Sandbox Refunds V2 scenario: approved, declined, error or cancelled.
# Never expose as a frontend field. Omit for ordinary processing.
# WOMPI_REFUND_TEST_SCENARIO=approved
