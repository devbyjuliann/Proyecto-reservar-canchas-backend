# Copy to .env.test.local and fill with test-only credentials. This file is ignored by Git.
# In production, provide NODE_ENV, DB_*, and an exact HTTPS FRONTEND_ORIGIN via the environment.
# PORT is optional (defaults to 3000); HOST is optional (defaults to 127.0.0.1).
# Production migrations additionally require MIGRATION_DB_USER and MIGRATION_DB_PASSWORD.
NODE_ENV=test
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reserva_canchas_test
DB_PASSWORD=replace_with_test_password
DB_NAME=reserva_canchas_test
# In development/test, messages are written to backend/.password-reset-outbox.jsonl by default.
# PASSWORD_RESET_OUTBOX_PATH=absolute/path/to/private/outbox.jsonl
# Production requires a verified sender and Resend API credential:
# PASSWORD_RESET_FROM_EMAIL=Reserva Canchas <recuperacion@example.com>
# RESEND_API_KEY=replace_in_production_environment_only
